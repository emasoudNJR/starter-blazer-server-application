@page "/TestAPI"
@inject ApiService ApiService

<h3>Items</h3>

@if (items == null)
{
    <p>Loading...</p>
}
else
{
    <ul>
        @foreach (var item in items)
        {
            <li>@item.Name</li>
        }
    </ul>
}

@code {
    List<Item>? items;

    protected override async Task OnInitializedAsync()
    {
        items = await ApiService.GetItems();
    }
}